<?xml version="1.0" encoding="UTF-8"?>
<!-- LaunchAgent: an application in the user session (autologon required).
     /Library/LaunchAgents/com.example.studio-ui.plist (root:wheel, 644).
     Autologon: Settings → Users & Groups → "Automatically log in as". Works only with FileVault off. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.example.studio-ui</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/open</string><string>-W</string><string>/Applications/StudioUI.app</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>LimitLoadToSessionType</key><string>Aqua</string>
</dict>
</plist>
