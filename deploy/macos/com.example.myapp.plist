<?xml version="1.0" encoding="UTF-8"?>
<!-- /Library/LaunchDaemons/com.example.myapp.plist (owner root:wheel, mode 644)
     Load: sudo launchctl bootstrap system /Library/LaunchDaemons/com.example.myapp.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.example.myapp</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/myapp/run.sh</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>StandardOutPath</key><string>/var/log/myapp.log</string>
  <key>StandardErrorPath</key><string>/var/log/myapp.err.log</string>
</dict>
</plist>
